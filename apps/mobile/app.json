{
  "expo": {
    "name": "HR Transport",
    "slug": "hr-transport",
    "scheme": "hrtransport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hrtransport.mobile",
      "infoPlist": { "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }, "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.hrtransport.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      ["expo-image-picker", { "photosPermission": "Allow HR Transport to choose your profile photo.", "cameraPermission": false, "microphonePermission": false }],
      "expo-document-picker"
    ],
    "runtimeVersion": { "policy": "appVersion" }
  }
}
